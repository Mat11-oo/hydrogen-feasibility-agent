# 复制本文件为 backend/.env 并填入真实值（.env 已被 .gitignore 忽略，不会进仓库）
# 模型走 OpenAI 兼容接口（决策台账 D4：DeepSeek，国内模型、资料不出境）

# DeepSeek API Key（在 https://platform.deepseek.com 的「API Keys」创建）
MODEL_API_KEY=

# OpenAI 兼容端点（DeepSeek 用这个；换其他厂商时改这里）
MODEL_BASE_URL=https://api.deepseek.com

# 写章用模型 / 审计用模型（DeepSeek 通用模型 deepseek-chat）
MODEL_NAME=deepseek-chat
REVIEW_MODEL_NAME=deepseek-chat

# 模型超时与重试（PRD 第五节：重试最多 3 次）
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=3
